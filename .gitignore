*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# ======== 自定义忽略文件 ==========
!/public/.htaccess

/.vagrant
*.conf
# 忽略仓库中根目录下的 .settings 文件或目录
/.settings
# 忽略所有 . 开头的目录
.*/
# 忽略所有 . 开头的文件
.*
!.gitkeep
# 排除.env.example文件
!.env.example
!.gitignore

# Office 缓存文件
~'$'*.docx
~'$'*.doc
~'$'*.ppt
~'$'*.pptx
~'$'*.xlsx
~'$'*.xls

# ======== 构建中间产物（无需入库）========
# 编译脚本已固定使用 sass --no-source-map，历史遗留的 .map 与当前 CSS 不同步，
# 属于过期中间产物，已清理，后续不再跟踪。
*.map

# ======== 本地临时脚本（无需入库）========
# 一次性验证/对比脚本通常硬编码本机绝对路径（如 node_modules/playwright 的绝对 import），
# 不可移植，不应进入版本库。
*.mjs
